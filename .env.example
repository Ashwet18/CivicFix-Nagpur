# Application Environment
ENVIRONMENT=development

# Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/civicfix_db

# API Security
API_SECRET_KEY=your-secret-key-here-generate-a-secure-random-string

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8081

# ML Model Configuration
MODEL_PATH=./ml/models

# Local AI Classification — Ollama (no API key required)
# 1. Install Ollama:  https://ollama.com/download
# 2. Pull the model:  ollama pull qwen2.5:3b
# 3. Start server:    ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# HTTP request timeout for classification calls (seconds)
OLLAMA_TIMEOUT=30

# Duplicate Detection Configuration
DUPLICATE_SEARCH_RADIUS_METERS=20
